{
  "name": "lohan-moraes-portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vp build",
    "typecheck": "tsc -b",
    "typecheck:app": "tsc -b tsconfig.app.json tsconfig.node.json",
    "typecheck:test": "tsc -b tsconfig.test.json",
    "preview": "vp preview",
    "check": "vp fmt --check && vp lint --tsconfig ./tsconfig.test.json",
    "check:fix": "vp fmt && vp lint --fix --tsconfig ./tsconfig.test.json",
    "lint": "vp lint --tsconfig ./tsconfig.test.json",
    "lint:fix": "vp lint --fix --tsconfig ./tsconfig.test.json",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "staged": "vp staged",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "validate": "vp fmt --check && vp lint --tsconfig ./tsconfig.test.json && vp test run",
    "assets:brand": "bun scripts/generate-brand-assets.ts",
    "assets:photos": "bun scripts/compress-photos.ts",
    "assets": "bun run assets:brand && bun run assets:photos",
    "fallow": "fallow",
    "fallow:audit": "fallow audit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.28",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fallow": "^3.48.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "latest",
    "vitest": "5.1.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vitest": "5.1.1"
  },
  "packageManager": "bun@1.4.5"
}
